[Unit]
Description=AgentChat Relay — Multi-agent group chat server
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/lisergico25/projects/agentchat
ExecStart=/home/lisergico25/projects/agentchat/agentchat-relay -addr 127.0.0.1:18950
Restart=always
RestartSec=5
Environment=HOME=/home/lisergico25

[Install]
WantedBy=default.target
